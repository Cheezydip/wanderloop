# Backend server port
PORT=3001

# Anthropic Claude API Key (Required for backend AI loop)
CLAUDE_API_KEY=sk-ant-placeholder_token

# NVIDIA NIM (NVIDIA API Catalog - Free 1,000 credits)
# Obtain a key starting with `nvapi-` at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-placeholder_token
NIM_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Mapbox Access Token (Optional/Deprecated - replaced by MapLibre + OpenFreeMap)
VITE_MAPBOX_TOKEN=pk.placeholder_token

# OpenRouteService API Key (Required for backend Directions, Geocoding, and POIs)
ORS_API_KEY=placeholder_token

# Google OAuth2 Credentials (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

