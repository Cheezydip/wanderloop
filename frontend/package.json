{
  "name": "@wanderloop/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'); ['build', 'out'].forEach(d => fs.cpSync('dist', d, {recursive:true}));\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.0.0",
    "animejs": "^4.5.0",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.0.0",
    "three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.2.5"
  }
}
