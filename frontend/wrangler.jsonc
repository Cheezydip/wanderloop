{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanderloop",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BACKEND_URL": "https://wanderloop.onrender.com"
  }
}